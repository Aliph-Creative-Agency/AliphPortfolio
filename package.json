{
  "name": "aliphcreative-site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "aliphcreative.com: static site in prototype/ served by the aliphcreative Worker (worker/). Dev tooling only; nothing here is bundled into the page.",
  "scripts": {
    "dev": "wrangler dev --local --port 8831 --inspector-port 9231",
    "test": "vitest run -c worker/vitest.config.ts",
    "check:site": "node --check prototype/main.js && node resources/build_static.mjs --check",
    "gen:defaults": "node worker/scripts/gen-defaults.mjs",
    "typecheck": "tsc -p worker"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.23.0",
    "@cloudflare/workers-types": "5.20261028.1",
    "@vitest/runner": "4.1.12",
    "@vitest/snapshot": "4.1.12",
    "playwright-core": "1.64.1",
    "typescript": "5.9.3",
    "vitest": "4.1.12",
    "wrangler": "4.155.0"
  }
}
